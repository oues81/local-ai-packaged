<clickhouse>
    <max_concurrent_queries>100</max_concurrent_queries>
    
    <!-- Single node Keeper setup -->
    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>/var/log/clickhouse-server/keeper</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/keeper_snapshot</snapshot_storage_path>
        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
            <raft_logs_level>warning</raft_logs_level>
        </coordination_settings>
        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>localhost</hostname>
                <port>9181</port>
            </server>
        </raft_configuration>
    </keeper_server>
    
    <remote_servers>
        <default>
            <shard>
                <replica>
                    <host>clickhouse</host>
                    <port>9000</port>
                </replica>
            </shard>
        </default>
    </remote_servers>
    
    <macros>
        <shard>1</shard>
        <replica>1</replica>
        <cluster>default</cluster>
    </macros>
</clickhouse>