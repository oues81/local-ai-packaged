# =============================================================================
# MCP Server Dockerfile — follows docker-build-standards
# See: docs/docker-build-standards/README.md §3.1
# =============================================================================

# Stage 1: dependencies (cached unless pyproject.toml or uv.lock changes)
FROM python:3.11-slim-bookworm AS deps

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_CACHE_DIR=/tmp/uv-cache

# Install uv (fast Python package manager)
COPY --from=ghcr.io/astral-sh/uv:0.11.6 /uv /usr/local/bin/uv

# Copy lockfile and manifest FIRST (before source — enables layer caching)
COPY pyproject.toml uv.lock ./

# Install dependencies with uv cache mount
# --frozen: use lockfile as-is, no resolution
# --no-dev: skip dev/test dependencies for production image
# --no-install-project: install deps only, not the project itself yet
RUN --mount=type=cache,target=/tmp/uv-cache \
    uv sync --frozen --no-dev --no-install-project

# Stage 2: runner (minimal image, source changes don't invalidate deps layer)
FROM python:3.11-slim-bookworm AS runner

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PATH="/app/.venv/bin:$PATH"

# Copy virtual environment from deps stage (uv creates .venv automatically)
COPY --from=deps /app/.venv /app/.venv

# Create non-root user
RUN groupadd --system --gid 1001 mcp && \
    useradd --system --uid 1001 --gid mcp --home-dir /app --shell /usr/sbin/nologin mcp

# Copy MCP server source
COPY --chown=mcp:mcp mcp_server/ ./mcp_server/

USER mcp

# Expose MCP server port
EXPOSE 8000

# Health check (uses python stdlib — no curl needed in runner stage)
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health',timeout=5).status==200 else 1)"

# Run the MCP server over HTTP/SSE so it can be used from Docker Compose
CMD ["python", "-m", "mcp_server.http_server"]
